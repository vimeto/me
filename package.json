{
  "name": "personal_page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && pnpm build:client && pnpm build:server && pnpm prerender",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-posts.ts",
    "validate:smoke": "tsx tests/validator.smoke.ts",
    "docs:registry": "tsx scripts/generate-registry-docs.ts",
    "ladle:dev": "ladle serve",
    "ladle:build": "ladle build",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:test": "tsx worker/tests/worker.test.ts",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "prepare": "husky"
  },
  "lint-staged": {
    "content/**/*.mdx": "tsx scripts/validate-posts.ts",
    "*.{ts,tsx,js,mjs,cjs}": "eslint --fix"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@shikijs/rehype": "^4.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@visx/axis": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/text": "^3.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "framer-motion": "^12.23.12",
    "hono": "^4.12.14",
    "jose": "^6.2.2",
    "katex": "^0.16.45",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.14.2",
    "rehype-katex": "^7.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260421.1",
    "@eslint/js": "^9.33.0",
    "@ladle/react": "^5.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "^1.59.1",
    "@types/d3-array": "^3.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-glob": "^3.3.3",
    "globals": "^16.3.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^7.1.2",
    "wrangler": "^4.84.1"
  }
}
